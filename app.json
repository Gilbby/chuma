{
  "expo": {
    "name": "Chuma",
    "slug": "chuma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chuma",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chuma.app"
    },
    "android": {
      "package": "com.chuma.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A5C36"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "resizeMode": "cover",
          "backgroundColor": "#0A5C36",
          "enableFullScreenImage_legacy": true,
          "android": {
            "image": "./assets/images/adaptive-icon.png",
            "imageWidth": 288,
            "resizeMode": "contain",
            "backgroundColor": "#0A5C36"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Chuma to use Face ID to sign you in and confirm transactions."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Chuma to access your contacts so you can add group officials by phone number."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c8d833c-6305-4a58-b464-13bd628b4a8f"
      }
    },
    "owner": "gilbert144"
  }
}
